 }
 
 case "$MODE" in
@@ -46,7 +50,7 @@ case "$MODE" in
     build
     FX="$KSP_DIR/GameData/VolumetricExplosions"
     mkdir -p "$FX/PluginData"
-    cp "$OUT/VolumetricExplosions.dll" "$FX/"
+    cp "$OUT/VolumetricExplosions.dll" "$OUT/RealBattery.cfg" "$FX/"

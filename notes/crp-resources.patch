+	Lithium = Ore
+	Lithium6 = Ore
+	LithiumHydride = Ore
+	LithiumDeuteride = Ore
+	Sodium = Ore
+	Potassium = Ore
+	Caesium = Ore
+	Calcium = Ore
+	Magnesium = Ore
+	Lead = Ore
+	LeadBallast = Ore
+	Uraninite = Ore
+	EnrichedUranium = Ore
+	DepletedUranium = Ore
+	DepletedFuel = Ore
+	Actinides = Ore
+	UraniumNitride = Ore
+	UF4 = Ore
+	Thorium = Ore
+	ThF4 = Ore
+	Plutonium-238 = Ore
+
+	// ---- stored electricity (a blue-white flash, by the units held): a capacitor's, unit for unit. (With RealBattery
+	// the name is a battery's and a unit is 3600 of the game's: RealBattery.cfg, beside the library, says so)
+	StoredCharge = ElectricCharge
+
+	// ---- left out: intakes, supplies, parts, and what has no mass or no look of its own
+	IntakeAtm = None
+	IntakeLqd = None
+	CompressedAir = None
+	Food = None
+	Supplies = None
+	ColonySupplies = None
+	Fertilizer = None
+	Mulch = None
+	Organics = None
+	Waste = None
+	Recyclables = None
+	Chemicals = None
+	Polymers = None
+	PolyvinylChloride = None
+	Machinery = None
+	MaterialKits = None
+	SpecializedParts = None
